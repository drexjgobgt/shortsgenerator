# ============================================================
# shortsgen - contoh konfigurasi. Salin ke .env lalu isi.
# JANGAN pernah commit file .env (sudah masuk .gitignore).
# ============================================================

# --- Mode aplikasi -------------------------------------------------
# mock = tanpa jaringan sama sekali (aman untuk contoh & test)
# live = memakai 9Router / provider nyata
APP_MODE=mock

# --- 9Router (gateway AI) ------------------------------------------
NINE_ROUTER_BASE_URL=http://localhost:20128
# API key dashboard 9Router. Kosongkan bila memakai discovery lokal.
NINE_ROUTER_API_KEY=
# Izinkan pembacaan API key dari DB lokal 9Router bila env kosong.
# Windows: %APPDATA%\9router\db\data.sqlite
NINE_ROUTER_API_KEY_FROM_LOCAL_DB=false

# --- Model & provider (lihat docs/9router-compatibility-report.md) --
# Model utama + rantai fallback (dipisah koma, urut prioritas).
LLM_MODEL=kios/deepseek-v4.1-flash-free
LLM_MODEL_FALLBACKS=ag/gemini-3.8-flash,gemini/gemini-3.8-flash
# TTS: edge-tts/<voice> (gratis) atau google-tts/<kode-bahasa>
TTS_MODEL=edge-tts/id-ID-ArdiNeural
# Model image AI (opsional; memakai kuota subscription Antigravity).
# Kosongkan untuk memaksa fallback grafis FFmpeg.
IMAGE_MODEL=ag/gemini-3.1-flash-image
# Kosongkan bila tidak tersedia (status not_configured).
VIDEO_MODEL=
STT_MODEL=
SEARCH_PROVIDER=
FETCH_PROVIDER=

# --- Batas aman -----------------------------------------------------
MAX_VIDEO_SECONDS=120
MAX_ASSET_MB=200
MAX_PARALLEL_JOBS=1
DISK_QUOTA_MB=2000
HTTP_TIMEOUT_S=180
HTTP_MAX_RETRIES=2
# Tolak semua provider berbayar kecuali diaktifkan eksplisit.
ALLOW_PAID_PROVIDERS=false

# --- Produksi konten -------------------------------------------------
# Durasi target naskah (detik). 15-35 dtk = rentang optimal YouTube Shorts.
TARGET_DURATION_S=30
SCRIPT_MAX_SCENES=10
# Review tambahan oleh LLM (menggunakan kuota provider).
REVIEW_LLM_PASS=false
# Blokir naskah yang memakai fakta belum terverifikasi otomatis.
BLOCK_UNVERIFIED_CLAIMS=false
# Anggaran gambar AI per job (kuota provider).
MAX_AI_IMAGES_PER_JOB=8
# Suara: auto | male | female | id suara lengkap (mis. id-ID-GadisNeural)
TTS_VOICE_MODE=auto

# --- Retensi Shorts (lihat docs/shorts-retention-playbook.md) --------
# Batas panjang satu shot: scene lebih panjang dipecah otomatis (2-4 dtk ideal).
MAX_SCENE_SECONDS=4
# dynamic = caption karaoke 2-3 kata + pop-in + overlay hook; static = frasa biasa.
CAPTIONS_STYLE=dynamic
# Tampilkan teks hook besar di 2,5 detik pertama.
HOOK_OVERLAY=true
# Musik latar: procedural (dibuat lokal, bebas lisensi) | folder | off
MUSIC_MODE=procedural
# Untuk MUSIC_MODE=folder: folder berisi lagu + licenses.json (lisensi tiap file).
MUSIC_DIR=
# Level musik relatif terhadap narasi (ducking sidechain otomatis).
MUSIC_VOLUME_DB=-18
MUSIC_BPM=120
# Efek whoosh pada setiap pergantian scene.
SFX_ENABLED=true

# --- Voice acting ekspresif ------------------------------------------
# auto = pakai edge-tts lokal bila terpasang (prosody nyata), fallback 9Router.
# edge-local = wajib lokal; 9router = tanpa prosody; mock = offline.
TTS_ENGINE=auto
# Profil suara: auto | warm_curious | energetic_nerd | calm_storyteller
TTS_VOICE_PROFILE=auto
# Aktifkan prosody per emosi (rate/pitch/volume + jeda).
TTS_EMOTION=true
# High-pass + presence EQ + kompresi + limiter + loudnorm.
TTS_POSTPROCESS=true

# --- Cerita & visual sinematik ---------------------------------------
# Karakter seri berulang (opsional), mis. "curious fox scientist".
SERIES_CHARACTER=
# Kirim gambar pertama sebagai reference ke gambar scene berikutnya.
REFERENCE_CHAIN=true
# Override gaya visual global (kosong = pilih otomatis dari arketipe).
VISUAL_STYLE=
# ai_first = gambar AI utama, stok hanya bila sangat relevan | stock_first | off
STOCK_POLICY=ai_first
STOCK_MAX_CLIPS_PER_JOB=2
# off | heuristic | llm (vision check memakai kuota model)
VISUAL_RELEVANCE_CHECK=heuristic
VISUAL_RELEVANCE_MIN=6
VISION_MODEL=ag/gemini-3.8-flash
# Tulis evaluation.json + evaluation.md setelah QA.
EVALUATION_REPORT=true
# Cache file untuk respons LLM/gambar/TTS yang sukses (hemat kuota saat rerun).
CACHE_ENABLED=true
CACHE_DIR=
CACHE_TTL_HOURS=168

# --- Render sinematik -------------------------------------------------
# cinematic = camera moves terencana + grade + grain + xfade; legacy = renderer lama.
RENDER_ENGINE=cinematic
# low | medium | high (amplitudo gerak kamera)
MOTION_INTENSITY=medium
TRANSITIONS=true
# off | basic | narrative (SFX impact/riser/heartbeat/sparkle dari naskah)
SFX_MODE=narrative
# Volume musik mengikuti bagian intro/build/climax/outro.
MUSIC_SECTIONS=true

# --- Render (FFmpeg) --------------------------------------------------
# fast = 720x1280 ultrafast (uji cepat) | final = 1080x1920 siap YouTube
RENDER_PRESET=fast
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30

# --- Stok video (opsional; keduanya GRATIS, hanya butuh API key) ------
# Pexels: daftar gratis di https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: daftar gratis di https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Folder klip milik Anda sendiri (butuh licenses.json berisi lisensi tiap file)
STOCK_LOCAL_DIR=
# Prioritas provider: pexels | pixabay | local-stock (kosong = urutan default)
STOCK_PREFER=

# --- YouTube (Fase F) -----------------------------------------------
# Default private + wajib persetujuan manual sebelum publikasi.
UPLOAD_VISIBILITY=private
REQUIRE_APPROVAL=true
# OAuth YouTube (Desktop client). Jangan commit isinya.
YOUTUBE_CLIENT_SECRETS=client_secrets.json
# Kosong = <DATA_DIR>/auth/token.json
YOUTUBE_TOKEN_PATH=
# Wajib diisi eksplisit sesuai audiens; default false (bukan konten anak).
YOUTUBE_MADE_FOR_KIDS=false
# Video memakai gambar/aset AI -> deklarasikan media sintetis.
YOUTUBE_SYNTHETIC_DISCLOSURE=true
YOUTUBE_UPLOAD_CHUNK_MB=8
YOUTUBE_PROCESSING_TIMEOUT_S=60

# --- Paths -----------------------------------------------------------
DATA_DIR=./data
LOGS_DIR=./logs
# Path ffmpeg bila tidak ada di PATH, contoh: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
